{
  "name": "gamified-waste-management",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm --prefix artifacts/api-server run dev",
    "dev:web": "npm --prefix artifacts/waste-gamify run dev",
    "build": "npm run build --workspaces --if-present",
    "start": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "db:init": "node -e \"import('./lib/db/src/index.js').then(m => m.initDatabase(m.pool)).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "db:push": "npm --prefix lib/db run push",
    "db:push-force": "npm --prefix lib/db run push-force"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1"
  }
}
